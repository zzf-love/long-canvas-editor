{
  "name": "long-canvas-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first long-form design editor with continuous canvas, editable SVG layers and a local revision bridge.",
  "license": "MIT",
  "author": "zzf-love",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzf-love/long-canvas-editor.git"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 7910 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/standalone.mjs",
    "serve": "node scripts/background-server.mjs",
    "bridge": "node scripts/background-update.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.mts tests/*.test.mjs tests/io-test.ts",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@playwright/test": "^1.63.0",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
